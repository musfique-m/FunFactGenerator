{
  "manifest_version": 3,
  "name": "Fun Fact Generator",
  "version": "1.0.0",
  "description": "Click the icon to drop a random fun fact into the focused text field (and copy it to your clipboard).",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Insert a random fun fact",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
